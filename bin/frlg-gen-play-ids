#!/usr/bin/env python3
"""Generate crates/frlg-human/src/play/ids.rs: game id -> constant name for species, moves and
trainers, from the decomp's constant headers (the controller reads ids from RAM, the simulator's
`Dex` is keyed by name).

Sources: decompiled/include/constants/species.h, decompiled/include/constants/moves.h,
decompiled/include/constants/opponents.h. Only plain `#define NAME <decimal>` lines are taken.

usage: bin/frlg-gen-play-ids [decomp-dir]   (default: ./decompiled)
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DECOMP = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, "decompiled")
OUT = os.path.join(ROOT, "crates", "frlg-human", "src", "play", "ids.rs")


def table(header, prefix):
    pat = re.compile(r"^#define\s+(" + prefix + r"[A-Z0-9_]+)\s+(\d+)\s*(//.*)?$")
    out = {}
    with open(os.path.join(DECOMP, header)) as f:
        for line in f:
            m = pat.match(line.strip())
            if m:
                out.setdefault(int(m.group(2)), m.group(1))
    return [out.get(i, "") for i in range(max(out) + 1)]


def emit(name, src, rows):
    body = "".join(f'    "{r}",\n' for r in rows)
    return f"/// Index = game id; `\"\"` = no plain define. Source: `decompiled/{src}`.\npub const {name}: &[&str] = &[\n{body}];\n\n"


text = "//! Generated by `bin/frlg-gen-play-ids`; do not edit.\n\n"
text += emit("SPECIES", "include/constants/species.h", table("include/constants/species.h", "SPECIES_"))
text += emit("MOVES", "include/constants/moves.h", table("include/constants/moves.h", "MOVE_"))
text += emit("TRAINERS", "include/constants/opponents.h", table("include/constants/opponents.h", "TRAINER_"))
with open(OUT, "w") as f:
    f.write(text.rstrip("\n") + "\n")
print(OUT)
