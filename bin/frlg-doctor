#!/usr/bin/env bash
#
# Says what actually works in this sandbox. Run it first in any new sandbox: the base
# image's contents are not under our control, and the prebuilt tools in the deps mount
# were compiled on the host, so an ABI mismatch shows up as a confusing failure three
# steps later unless it is checked here.

set -uo pipefail
[ -f /etc/profile.d/10-frlg.sh ] && . /etc/profile.d/10-frlg.sh

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail=0

chk() { # chk <label> <command...>
  local label="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  %s ok  %s %-26s %s%s%s\n' "$GREEN" "$OFF" "$label" "$DIM" "$(head -1 <<<"$out")" "$OFF"
  else
    printf '  %s FAIL%s %-26s %s\n' "$RED" "$OFF" "$label" "$(head -1 <<<"$out")"
    fail=1
  fi
}
have() { # have <label> <path>
  if [ -e "$2" ]; then printf '  %s ok  %s %-26s %s%s%s\n' "$GREEN" "$OFF" "$1" "$DIM" "$2" "$OFF"
  else printf '  %s FAIL%s %-26s missing: %s\n' "$RED" "$OFF" "$1" "$2"; fail=1; fi
}

echo
echo "mounts"
have "deps"        "${FRLG_DEPS:-/nonexistent}"
have "decomp (ro)" "${FRLG_DECOMP_RO:-/nonexistent}"
have "decomp (rw copy)" "${FRLG_DECOMP:-/nonexistent}/Makefile"
have "artifacts"   "${FRLG_ARTIFACTS:-/nonexistent}/.frlg-artifacts"
if [ -n "${FRLG_ARTIFACTS:-}" ]; then
  if touch "$FRLG_ARTIFACTS/.wtest" 2>/dev/null; then
    rm -f "$FRLG_ARTIFACTS/.wtest"
    printf '  %s ok  %s %-26s\n' "$GREEN" "$OFF" "artifacts is writable"
  else
    printf '  %s FAIL%s %-26s (did mounts.json append :rw?)\n' "$RED" "$OFF" "artifacts is writable"; fail=1
  fi
fi

echo
echo "image (built by tools/host-prep.sh -- a FAIL here means the sandbox is on the stock image)"
# The stock sbx image has no compiler at all. perl and bash are not optional either:
# the decomp Makefile sets SHELL := bash -o pipefail, and `syms` pipes objdump through perl.
for c in cc gcc g++ ld make python3 perl bash tar git pkg-config cmake; do chk "$c" "$c" --version; done
chk "arm-none-eabi-as"  arm-none-eabi-as --version
chk "arm-none-eabi-ld"  arm-none-eabi-ld --version
chk "libpng"            pkg-config --modversion libpng

echo
echo "env (profile.d reaches login shells; almost nothing here is one)"
# Reproduce what the harness does rather than asking this shell, which has already
# sourced the profile and would inherit the answer: a clean environment plus the
# BASH_ENV the harness sets. If these fail, the source line is missing from
# /etc/sandbox-persistent.sh and only `bash -l` sees the toolchain.
envfile="${BASH_ENV:-${CLAUDE_ENV_FILE:-/etc/sandbox-persistent.sh}}"
chk "vars in a non-login bash" sh -c '
  v=$(env -i HOME="$HOME" BASH_ENV="'"$envfile"'" bash -c "echo \$FRLG_DEPS")
  [ -n "$v" ] && echo "'"$envfile"' -> $v"'
chk "PATH in a non-login bash" sh -c '
  env -i HOME="$HOME" PATH=/usr/bin:/bin BASH_ENV="'"$envfile"'" bash -c "command -v cargo"'

echo
echo "toolchain (prebuilt on the host -- a FAIL here is usually a glibc/ABI mismatch)"
# A real compile, not --version: agbcc exits 0 on an unknown option, so `agbcc --version`
# reports ok on a binary that cannot run at all.
chk "agbcc compiles" sh -c '
  t=$(mktemp -d); trap "rm -rf $t" EXIT
  printf "int f(int x){return x+1;}\n" > "$t/t.i"
  "$FRLG_DEPS/agbcc/bin/agbcc" -o "$t/t.s" "$t/t.i" >/dev/null 2>&1 || exit 1
  grep -q "^f:" "$t/t.s" && echo "emitted arm asm"'
have "agbcc in decomp"  "${FRLG_DECOMP:-/nonexistent}/tools/agbcc/bin/agbcc"
chk "cargo"             cargo --version
chk "rustc"             rustc --version
# Components, not binaries that come with the toolchain: rustup installs them on the host
# and `rustup component add` cannot run here. A FAIL means the deps tree predates the
# RUST_COMPONENTS line in tools/host-prep.sh -- re-run it with --force rust on the host.
chk "cargo clippy"      cargo clippy --version
chk "cargo fmt"         cargo fmt --version
chk "sccache"           sccache --version
have "vendored crates"  "${FRLG_DEPS:-/nonexistent}/cargo-vendor"
# dlopen, not stat: the whole point of the check is whether the loader can satisfy it,
# and a libmgba.so with an unsatisfiable dependency passes every test but this one.
chk "libmgba loads"     python3 -c 'import ctypes, os
p = os.environ["MGBA_PREFIX"] + "/lib/libmgba.so"
ctypes.CDLL(p)
print(os.path.realpath(p))'
have "mgba headers"     "${MGBA_PREFIX:-/nonexistent}/include/mgba/core/core.h"
have "bizhawk (ref)"    "${BIZHAWK_HOME:-/nonexistent}"

echo
echo "network (blocked is the point; api.anthropic.com is the one exception)"
# Three ways to get this wrong, all of which have happened here:
#   - trusting curl's exit code: the proxy denies with a 403 *page*, which curl calls
#     success, so an exit-code test reports a closed network as open;
#   - trusting curl's exit code the other way: when curl itself is broken it fails on
#     every host, and the same test reports an open network as closed;
#   - trusting the 403: crates.io answers 403 to a bare request all by itself, so the
#     status code alone cannot tell "the proxy stopped us" from "we got there".
# The proxy names itself in the body. That is the only thing worth matching on.
netchk() { # netchk <host> <blocked|open>
  local resp code body verdict
  resp=$(curl -sS --max-time 6 -w $'\n%{http_code}' "https://$1" 2>/dev/null) || resp=$'\n000'
  code="${resp##*$'\n'}"
  body="${resp%$'\n'*}"
  case "$body" in
    *"locked by network policy"*) verdict=blocked ;;
    *) [ "$code" = 000 ] && verdict=silent || verdict=open ;;
  esac
  case "$2:$verdict" in
    blocked:blocked) printf '  %s ok  %s %-26s blocked by policy (%s)\n' "$GREEN" "$OFF" "$1" "$code" ;;
    open:open)       printf '  %s ok  %s %-26s reachable (%s)\n' "$GREEN" "$OFF" "$1" "$code" ;;
    blocked:open)    printf '  %s !! %s %-26s answered HTTP %s itself -- reachable, the kit allowlist is too wide\n' "$YELLOW" "$OFF" "$1" "$code"; fail=1 ;;
    open:blocked)    printf '  %s FAIL%s %-26s blocked by policy -- the kit allowlist does not cover it\n' "$RED" "$OFF" "$1"; fail=1 ;;
    *:silent)        printf '  %s FAIL%s %-26s no answer at all -- is curl itself working? (curl -v https://%s)\n' "$RED" "$OFF" "$1" "$1"; fail=1 ;;
  esac
}
for h in crates.io pypi.org github.com tasvideos.org; do netchk "$h" blocked; done
netchk api.anthropic.com open

echo
echo "artifacts budget"
"$(dirname "$0")/frlg-artifacts-gc" --check || true

echo
if [ "$fail" -eq 0 ]; then
  printf '%s all good%s\n\n' "$GREEN" "$OFF"
else
  printf '%s something is wrong above%s\n\n' "$RED" "$OFF"
fi
exit "$fail"
