#!/usr/bin/env bash
#
# Says what actually works in this sandbox. Run it first in any new sandbox: the base
# image's contents are not under our control, and the prebuilt tools in the deps mount
# were compiled on the host, so an ABI mismatch shows up as a confusing failure three
# steps later unless it is checked here.

set -uo pipefail
[ -f /etc/profile.d/10-frlg.sh ] && . /etc/profile.d/10-frlg.sh

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail=0

chk() { # chk <label> <command...>
  local label="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  %s ok  %s %-26s %s%s%s\n' "$GREEN" "$OFF" "$label" "$DIM" "$(head -1 <<<"$out")" "$OFF"
  else
    printf '  %s FAIL%s %-26s %s\n' "$RED" "$OFF" "$label" "$(head -1 <<<"$out")"
    fail=1
  fi
}
have() { # have <label> <path>
  if [ -e "$2" ]; then printf '  %s ok  %s %-26s %s%s%s\n' "$GREEN" "$OFF" "$1" "$DIM" "$2" "$OFF"
  else printf '  %s FAIL%s %-26s missing: %s\n' "$RED" "$OFF" "$1" "$2"; fail=1; fi
}
# For things that are wrong but not this sandbox's fault and not fixable from in here. They must
# still be said out loud on every startup -- a known gap that nobody is reminded of is a gap that
# gets discovered by a desync three sessions later.
note() { # note <label> <text...>
  printf '  %s !! %s %-26s %s\n' "$YELLOW" "$OFF" "$1" "${*:2}"
}
info() { # info <label> <text...>
  printf '  %s --  %s %-26s %s%s%s\n' "$DIM" "$OFF" "$1" "$DIM" "${*:2}" "$OFF"
}

echo
echo "mounts"
have "deps"        "${FRLG_DEPS:-/nonexistent}"
have "decomp (ro)" "${FRLG_DECOMP_RO:-/nonexistent}"
have "decomp (rw copy)" "${FRLG_DECOMP:-/nonexistent}/Makefile"
have "artifacts"   "${FRLG_ARTIFACTS:-/nonexistent}/.frlg-artifacts"
if [ -n "${FRLG_ARTIFACTS:-}" ]; then
  if touch "$FRLG_ARTIFACTS/.wtest" 2>/dev/null; then
    rm -f "$FRLG_ARTIFACTS/.wtest"
    printf '  %s ok  %s %-26s\n' "$GREEN" "$OFF" "artifacts is writable"
  else
    printf '  %s FAIL%s %-26s (did mounts.json append :rw?)\n' "$RED" "$OFF" "artifacts is writable"; fail=1
  fi
fi

# Docs and route notes cite paths as `decompiled/...`, but the checkout lives outside the
# repo (it has to: a mount nested inside the workspace hangs sandbox create -- see the note
# on DECOMP_DEFAULT in tools/host-prep.sh) and the link is gitignored, so every sandbox
# starts without it.
# Recreating it here is idempotent and saves the citations from dangling.
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [ -n "${FRLG_DECOMP:-}" ] && [ -d "$FRLG_DECOMP" ]; then
  [ -L "$repo/decompiled" ] && [ "$(readlink "$repo/decompiled")" = "$FRLG_DECOMP" ] \
    || ln -sfn "$FRLG_DECOMP" "$repo/decompiled" 2>/dev/null
fi
have "decompiled/ citation root" "$repo/decompiled/include/gba/io_reg.h"

echo
echo "image (built by tools/host-prep.sh -- a FAIL here means the sandbox is on the stock image)"
# The stock sbx image has no compiler at all. perl and bash are not optional either:
# the decomp Makefile sets SHELL := bash -o pipefail, and `syms` pipes objdump through perl.
for c in cc gcc g++ ld make python3 perl bash tar git pkg-config cmake; do chk "$c" "$c" --version; done
chk "arm-none-eabi-as"  arm-none-eabi-as --version
chk "arm-none-eabi-ld"  arm-none-eabi-ld --version
chk "libpng"            pkg-config --modversion libpng

echo
echo "env (profile.d reaches login shells; almost nothing here is one)"
# Reproduce what the harness does rather than asking this shell, which has already
# sourced the profile and would inherit the answer: a clean environment plus the
# BASH_ENV the harness sets. If these fail, the source line is missing from
# /etc/sandbox-persistent.sh and only `bash -l` sees the toolchain.
envfile="${BASH_ENV:-${CLAUDE_ENV_FILE:-/etc/sandbox-persistent.sh}}"
chk "vars in a non-login bash" sh -c '
  v=$(env -i HOME="$HOME" BASH_ENV="'"$envfile"'" bash -c "echo \$FRLG_DEPS")
  [ -n "$v" ] && echo "'"$envfile"' -> $v"'
chk "PATH in a non-login bash" sh -c '
  env -i HOME="$HOME" PATH=/usr/bin:/bin BASH_ENV="'"$envfile"'" bash -c "command -v cargo"'

echo
echo "toolchain (prebuilt on the host -- a FAIL here is usually a glibc/ABI mismatch)"
# A real compile, not --version: agbcc exits 0 on an unknown option, so `agbcc --version`
# reports ok on a binary that cannot run at all.
chk "agbcc compiles" sh -c '
  t=$(mktemp -d); trap "rm -rf $t" EXIT
  printf "int f(int x){return x+1;}\n" > "$t/t.i"
  "$FRLG_DEPS/agbcc/bin/agbcc" -o "$t/t.s" "$t/t.i" >/dev/null 2>&1 || exit 1
  grep -q "^f:" "$t/t.s" && echo "emitted arm asm"'
have "agbcc in decomp"  "${FRLG_DECOMP:-/nonexistent}/tools/agbcc/bin/agbcc"
chk "cargo"             cargo --version
chk "rustc"             rustc --version
# Components, not binaries that come with the toolchain: rustup installs them on the host
# and `rustup component add` cannot run here. A FAIL means the deps tree predates the
# RUST_COMPONENTS line in tools/host-prep.sh -- re-run it with --force rust on the host.
chk "cargo clippy"      cargo clippy --version
chk "cargo fmt"         cargo fmt --version
chk "sccache"           sccache --version
# That the binary runs is not the question -- whether cargo is told to use it is. The wrapper
# line is generated at startup into a file nothing commits, so it is easy to lose and its loss is
# invisible: builds still work, they are just cold every time.
chk "sccache is wired in" sh -c '
  grep -q "^rustc-wrapper" "$HOME/.cargo/config.toml" 2>/dev/null || exit 1
  sed -n "s/^rustc-wrapper = //p" "$HOME/.cargo/config.toml"'
have "vendored crates"  "${FRLG_DEPS:-/nonexistent}/cargo-vendor"
# dlopen, not stat: the whole point of the check is whether the loader can satisfy it,
# and a libmgba.so with an unsatisfiable dependency passes every test but this one.
chk "libmgba loads"     python3 -c 'import ctypes, os
p = os.environ["MGBA_PREFIX"] + "/lib/libmgba.so"
ctypes.CDLL(p)
print(os.path.realpath(p))'
have "mgba headers"     "${MGBA_PREFIX:-/nonexistent}/include/mgba/core/core.h"
have "bizhawk (ref)"    "${BIZHAWK_HOME:-/nonexistent}"

# The two tiers run independently chosen mGBA cores, and any emulation-behaviour delta between
# them is a desync tier 1 is structurally incapable of seeing. Neither number is guessable at a
# glance -- ours is in the deps MANIFEST, BizHawk's is a [PortedCore] attribute in compiled CIL --
# so this reads both and says the delta every startup. It FAILS only on drift: if BizHawk's core
# is no longer the one host-prep recorded, the deps tree and the sandbox disagree about what
# tier 2 even is.
manifest="${FRLG_DEPS:-/nonexistent}/MANIFEST"
ours=$(sed -n 's/^mgba  *//p' "$manifest" 2>/dev/null | head -1)
recorded=$(sed -n 's/.*bundled mGBA \([^,)]*\).*/\1/p' "$manifest" 2>/dev/null | head -1)
submodule=$(sed -n 's/.*submodule \([0-9a-f]\{40\}\).*/\1/p' "$manifest" 2>/dev/null | head -1)
actual=$(python3 - "${BIZHAWK_HOME:-/nonexistent}/dll/BizHawk.Emulation.Cores.dll" 2>/dev/null <<'PY'
import re, sys
blob = open(sys.argv[1], "rb").read()
for m in re.finditer(rb"\x04mGBA", blob):
    i, out = m.end(), []
    for _ in range(2):
        n = blob[i]; out.append(blob[i + 1:i + 1 + n].decode("utf8", "replace")); i += 1 + n
    if out[0] == "endrift":
        print(out[1]); break
PY
)
if [ -z "$ours" ] || [ -z "$actual" ]; then
  printf '  %s FAIL%s %-26s could not read both core versions (ours=%s bizhawk=%s)\n' \
    "$RED" "$OFF" "mgba pin" "${ours:-?}" "${actual:-?}"; fail=1
elif [ -n "$recorded" ] && [ "$recorded" != "$actual" ]; then
  printf '  %s FAIL%s %-26s BizHawk now bundles mGBA %s, MANIFEST says %s -- deps tree is stale\n' \
    "$RED" "$OFF" "mgba pin" "$actual" "$recorded"; fail=1
elif [ "$ours" = "$actual" ] || { [ -n "$submodule" ] && [ "$ours" = "$submodule" ]; }; then
  printf '  %s ok  %s %-26s %sboth tiers on mGBA %s (BizHawk reports %s)%s\n' \
    "$GREEN" "$OFF" "mgba pin" "$DIM" "$ours" "$actual" "$OFF"
else
  note "mgba pin" "tier 1 is mGBA $ours, tier 2 (BizHawk) is $actual -- known gap, not fixable here"
fi

echo
echo "route inputs (what the citations and the replays are made of)"
# A sha1 comparison, never a rebuild: the point is to answer "is the ROM the harness will pick up
# the one everything was routed against", in a second, before anything else runs.
chk "rom matches firered.sha1" sh -c '
  rom="${FRLG_ROM:-$FRLG_ARTIFACTS/rom/pokefirered.gba}"
  [ -f "$rom" ] || { echo "no ROM at $rom -- build it (docs/sandbox.md)"; exit 1; }
  want=$(cut -d" " -f1 < "$FRLG_DECOMP_RO/firered.sha1")
  got=$(sha1sum "$rom" | cut -d" " -f1)
  [ "$want" = "$got" ] || { echo "$rom is $got, firered.sha1 wants $want"; exit 1; }
  echo "$got"'
have "rom symbols"      "${FRLG_ARTIFACTS:-/nonexistent}/rom/pokefirered.sym"

# Tier 1 boots from this file the moment it exists (frlg_emu::boot_with_default_bios),
# and tier 2 cannot run at all without it, so its state is said every startup. The pin
# is the World GBA BIOS, same as tools/verify-runner.sh's preflight.
bios="${FRLG_GBA_BIOS:-${BIZHAWK_HOME:-/nonexistent}/Firmware/GBA_bios.rom}"
bios_want=300c20df6731a33952ded8c436f7f186d25d3492
if [ -f "$bios" ]; then
  bios_got=$(sha1sum "$bios" 2>/dev/null | cut -d" " -f1)
  if [ "$bios_got" = "$bios_want" ]; then
    printf '  %s ok  %s %-26s %sWorld BIOS; tier 1 boots bios:%s...%s\n' \
      "$GREEN" "$OFF" "gba bios" "$DIM" "${bios_got%????????????????????????????????}" "$OFF"
  else
    printf '  %s FAIL%s %-26s %s is sha1 %s, the World BIOS is %s\n' \
      "$RED" "$OFF" "gba bios" "$bios" "${bios_got:-unreadable}" "$bios_want"; fail=1
  fi
else
  note "gba bios" "none at $bios -- tier 1 boots HLE, tier 2 cannot run (docs/rival-1/route.md)"
fi

# The copy carries no .git, so this stamp is the only thing that ties a citation to a revision of
# pret/pokefirered. Written by the kit's startup step; a missing one means the copy predates it.
if [ -f "${FRLG_DECOMP:-/nonexistent}/.frlg-src" ]; then
  info "decomp revision" "$(cat "$FRLG_DECOMP/.frlg-src")"
else
  note "decomp revision" "no ~/decomp/.frlg-src -- this copy predates the revision stamp, so what it was copied from is unknown"
fi

# ~/decomp is writable and the build writes into it. An accidental edit there silently changes
# what every `decompiled/foo.c:123` citation in the docs and the journal means, and citations are
# this project's substitute for a network -- so it is the one class of corruption it cannot
# afford. `Only in` lines are expected and must not fail this: the build generates headers
# (map_groups.h, items.h, ...) that exist only in the copy and are legitimately citable.
chk "decomp copy is faithful" sh -c '
  for d in src include; do
    diff -rq "$FRLG_DECOMP_RO/$d" "$FRLG_DECOMP/$d" 2>&1 | grep "differ" && exit 1
  done
  echo "no source file differs from the read-only mount"'

repo_root=${FRLG_REPO:-$repo}
if [ -f "$repo_root/route/template.bk2" ]; then
  printf '  %s ok  %s %-26s %s%s%s\n' "$GREEN" "$OFF" "tier-2 template" "$DIM" \
    "$(sha1sum "$repo_root/route/template.bk2" | cut -c1-12)" "$OFF"
else
  note "tier-2 template" "no route/template.bk2 -- regenerate it on the host (tools/bk2-template.sh)"
fi

echo
echo "network (blocked is the point; api.anthropic.com is the one exception)"
# Three ways to get this wrong, all of which have happened here:
#   - trusting curl's exit code: the proxy denies with a 403 *page*, which curl calls
#     success, so an exit-code test reports a closed network as open;
#   - trusting curl's exit code the other way: when curl itself is broken it fails on
#     every host, and the same test reports an open network as closed;
#   - trusting the 403: crates.io answers 403 to a bare request all by itself, so the
#     status code alone cannot tell "the proxy stopped us" from "we got there".
# The proxy names itself in the body. That is the only thing worth matching on.
netchk() { # netchk <host> <blocked|open>
  local resp code body verdict
  resp=$(curl -sS --max-time 6 -w $'\n%{http_code}' "https://$1" 2>/dev/null) || resp=$'\n000'
  code="${resp##*$'\n'}"
  body="${resp%$'\n'*}"
  case "$body" in
    *"locked by network policy"*) verdict=blocked ;;
    *) [ "$code" = 000 ] && verdict=silent || verdict=open ;;
  esac
  case "$2:$verdict" in
    blocked:blocked) printf '  %s ok  %s %-26s blocked by policy (%s)\n' "$GREEN" "$OFF" "$1" "$code" ;;
    open:open)       printf '  %s ok  %s %-26s reachable (%s)\n' "$GREEN" "$OFF" "$1" "$code" ;;
    blocked:open)    printf '  %s !! %s %-26s answered HTTP %s itself -- reachable, the kit allowlist is too wide\n' "$YELLOW" "$OFF" "$1" "$code"; fail=1 ;;
    open:blocked)    printf '  %s FAIL%s %-26s blocked by policy -- the kit allowlist does not cover it\n' "$RED" "$OFF" "$1"; fail=1 ;;
    *:silent)        printf '  %s FAIL%s %-26s no answer at all -- is curl itself working? (curl -v https://%s)\n' "$RED" "$OFF" "$1" "$1"; fail=1 ;;
  esac
}
for h in crates.io pypi.org github.com tasvideos.org; do netchk "$h" blocked; done
netchk api.anthropic.com open

echo
echo "tier-2 queue (a human on the host drives this; never block on it)"
# Answers come back into a directory nobody would think to look in. Say what is there at startup
# so a new session sees the verdict without being told where to find it.
if [ -d "${FRLG_ARTIFACTS:-/nonexistent}/verify" ]; then
  queued=$(find "$FRLG_ARTIFACTS/verify/queue" -name '*.bk2' 2>/dev/null | wc -l)
  results=$(find "$FRLG_ARTIFACTS/verify/results" -name '*.json' 2>/dev/null | wc -l)
  info "queued" "$queued waiting to be replayed"
  if [ "$results" -eq 0 ]; then
    info "results" "none yet"
  else
    info "results" "$results (newest first, docs/rival-1/route.md has the format)"
    find "$FRLG_ARTIFACTS/verify/results" -name '*.json' -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | head -5 | cut -d' ' -f2- | while read -r r; do
        python3 -c 'import json,sys
d = json.load(open(sys.argv[1]))
print("      %-20s %-7s %s" % (d.get("id"), d.get("verdict"), (d.get("notes") or "")[:70]))' "$r" 2>/dev/null \
          || printf '      %s (unreadable)\n' "$(basename "$r")"
      done
  fi
fi

echo
echo "artifacts budget"
"$(dirname "$0")/frlg-artifacts-gc" --check || true

echo
if [ "$fail" -eq 0 ]; then
  printf '%s all good%s\n\n' "$GREEN" "$OFF"
else
  printf '%s something is wrong above%s\n\n' "$RED" "$OFF"
fi
exit "$fail"
