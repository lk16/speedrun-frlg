    ("viridian-mart_to_viridian-gym", ('MAP_VIRIDIAN_CITY', 36, 19), ('MAP_VIRIDIAN_CITY', 36, 10), {}),
    ("viridian-mart_to_route22-gate", ('MAP_VIRIDIAN_CITY', 36, 19), ('MAP_ROUTE22', 8, 5), {}),
    ("route22-gate_to_victoryroad", ('MAP_ROUTE22', 8, 5), ('MAP_ROUTE23', 5, 28), {'surf': True}),
