     {'ignore_objects': True, 'surf': True}),
]


def cmd_path(argv):
    opts = {'surf': '--surf' in argv, 'cut': '--cut' in argv,
            'ignore_objects': '--ignore-objects' in argv}
    argv = [a for a in argv if not a.startswith('--')]
    ma, xy_a, mb, xy_b = argv
    ax, ay = map(int, xy_a.split(','))
    bx, by = map(int, xy_b.split(','))
    d, path = search((ma, ax, ay), [(mb, bx, by)], opts)
    if d is None:
        print('unreachable')
        return 1
    hops = [p[0] for p in path]
    seen = [hops[0]] if hops else []
    for h in hops[1:]:
        if h != seen[-1]:
            seen.append(h)
    print(f'{d} tiles  via {" -> ".join(s.replace("MAP_", "") for s in seen)}')
    return 0


def cmd_dump(argv):
    out = {'_format': 'frlg-mapgraph distance table, cost in tiles (see tool header for model caveats)',
           'frames_per_tile': {'walk': 16, 'run': 8, 'surf': 8, 'bike': 6,
                               '_cite': 'decompiled/src/event_object_movement.c:158-162,8866-8931'},
           'legs': []}
    for name, a, b, opts in LEGS:
        d, path = search(a, [b], opts)
        maps = []
        if path:
            for p in path:
                if not maps or maps[-1] != p[0]:
                    maps.append(p[0])
        out['legs'].append({'name': name, 'from': list(a), 'to': list(b),
                            'opts': opts, 'tiles': d, 'via': maps})
        print(f'{name:36s} {str(d):>6s} tiles')
    dest = argv[0] if argv else f'{os.path.dirname(os.path.dirname(os.path.abspath(__file__)))}/docs/glitchless-run/distances.json'
    json.dump(out, open(dest, 'w'), indent=1)
    print('wrote', dest)
    return 0


if __name__ == '__main__':
    if len(sys.argv) < 2 or sys.argv[1] not in ('path', 'dump'):
        print(__doc__)
        sys.exit(2)
    sys.exit({'path': cmd_path, 'dump': cmd_dump}[sys.argv[1]](sys.argv[2:]))
